server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Sin esto, nginx resuelve BACKEND_INTERNAL_HOST UNA sola vez al arrancar y cachea esa IP para
    # siempre. Cuando el backend se reinicia (deploy, redeploy, o incluso un `php spark db:seed`
    # que reinicia el contenedor), Railway le asigna una IP interna nueva y nginx se queda apuntando
    # a la vieja -> "no live upstreams", 502 en todo /api/, hasta que se reinicia el frontend
    # también. Usar una variable en proxy_pass fuerza a nginx a re-resolver el hostname en cada
    # petición (respetando el TTL de `valid`) en vez de una sola vez.
    #
    # RESOLVER_IP la calcula nginx-entrypoint.sh leyendo /etc/resolv.conf del propio contenedor —
    # Railway NO usa el DNS embebido de Docker Compose (127.0.0.11); hardcodearlo rompe la
    # resolución por completo ("recv() failed, Connection refused") en vez de solo cachear.
    resolver ${RESOLVER_IP} valid=10s ipv6=off;

    location /api/ {
        set $backend_upstream "http://${BACKEND_INTERNAL_HOST}:${BACKEND_INTERNAL_PORT}";
        proxy_pass $backend_upstream/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path / /;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
