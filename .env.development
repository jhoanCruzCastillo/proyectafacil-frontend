# Flags de datos falsos vs. reales, por recurso — 'true' usa el mock local (localStorage),
# 'false' llama al backend real de CodeIgniter en /api. Se migran uno por uno conforme el
# backend exponga cada endpoint (ver docs/database-design.md).
VITE_MOCK_AUTH=false
VITE_MOCK_SECTORES=false
VITE_MOCK_PLANTILLAS=false
VITE_MOCK_ARCHIVOS_EXCEL=false
VITE_MOCK_EJEMPLOS=false
VITE_MOCK_USUARIOS=false
VITE_MOCK_MENTORIAS=false
VITE_MOCK_FACTURACION=false
VITE_MOCK_HISTORIAL=false
VITE_MOCK_ACTIVIDAD=false
